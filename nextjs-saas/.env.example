# Copy to .env.local and fill in. Never commit the real file.

# Secret test-mode API key (Settings -> API keys, with Test mode on). Server only.
REFERALLI_API_KEY=rk_test_...

# The program new customers are attributed to (prg_...).
REFERALLI_PROGRAM_ID=prg_...

# Your endpoint's signing secret (whsec_...). For local testing use the one
# `referalli listen` prints.
REFERALLI_WEBHOOK_SECRET=whsec_...

# Public tracking token (tk_..., Settings -> Tracking). Safe in the browser.
NEXT_PUBLIC_REFERALLI_TRACKING_TOKEN=tk_...
