# Copy to .env. Expo inlines EXPO_PUBLIC_* variables into the app bundle, so
# only public values go here.

# Public tracking token (tk_..., Settings -> Tracking). Safe to ship in the app.
EXPO_PUBLIC_REFERALLI_TRACKING_TOKEN=tk_...

# The program installs are attributed to (prg_...).
EXPO_PUBLIC_REFERALLI_PROGRAM_ID=prg_...

# Never put your secret API key in the app. It belongs on your backend, which
# reports purchases with POST /v1/mobile/purchases. Shown here only so you know
# where it goes; do not add an EXPO_PUBLIC_ prefix to it.
# REFERALLI_API_KEY=rk_test_...
